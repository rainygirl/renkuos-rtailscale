+// newHaikuFileStore opens a persistent state store without stat or fstat.
+// Remove this once the Go Haiku/386 stat ABI is fully implemented.
+func newHaikuFileStore(logf logger.Logf, path string) (ipn.StateStore, error) {
+	logf("Haiku state: ensuring state directory")
+	if err := mkdirAllWithoutStat(filepath.Dir(path), 0700); err != nil {
+		return nil, fmt.Errorf("creating state directory: %w", err)
+	}
+
+	logf("Haiku state: opening %q", path)
