diff --git a/ssh/tailssh/incubator_haiku.go b/ssh/tailssh/incubator_haiku.go
new file mode 100644
index 0000000..60e41be
--- /dev/null
+++ b/ssh/tailssh/incubator_haiku.go
@@ -0,0 +1,184 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package tailssh
+
+import (
+	"fmt"
+	"os"
+	"strings"
+	"syscall"
+	"unsafe"
+
+	gliderssh "github.com/tailscale/gliderssh"
+	"golang.org/x/crypto/ssh"
+	"tailscale.com/types/logger"
+)
+
+// Haiku has no golang.org/x/sys/unix, and creack/pty and u-root's termios do
+// not support it, so the incubator's OS-specific parts are done here with
+// libroot's ioctl, called the way package syscall calls libroot.
+
+//go:cgo_import_dynamic libc___ioctl __ioctl "libroot.so"
+//go:linkname libc___ioctl libc___ioctl
+
+var libc___ioctl uintptr
+
+//go:linkname sysvicall6 syscall.sysvicall6
+func sysvicall6(trap, nargs, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err syscall.Errno)
+
+// ioctl calls __ioctl(fd, op, arg, size). Haiku's ioctl takes the size of
+// the argument as a fourth parameter.
+func ioctl(fd int, op uintptr, arg unsafe.Pointer, size uintptr) error {
+	_, _, e := sysvicall6(uintptr(unsafe.Pointer(&libc___ioctl)), 4, uintptr(fd), op, uintptr(arg), size, 0, 0)
+	if e != 0 {
+		return e
+	}
+	return nil
+}
+
+// From <termios.h> and <tty.h> (private).
+const (
+	haikuTCGETA                = 0x8000
+	haikuTCSETA                = 0x8001
+	haikuTIOCSWINSZ            = 0x800d
+	haikuB_IOCTL_GET_TTY_INDEX = 0x8020
+	haikuB_IOCTL_GRANT_TTY     = 0x8021
+)
+
+// haikuTermios is struct termios.
+type haikuTermios struct {
+	Iflag      uint16
+	Ispeed     uint16
+	Oflag      uint16
+	Ospeed     uint16
+	Cflag      uint16
+	IspeedHigh uint16
+	Lflag      uint16
+	OspeedHigh uint16
+	Line       uint8
+	_          [2]uint8
+	CC         [11]uint8
+}
+
+type haikuWinsize struct {
+	Row, Col, Xpixel, Ypixel uint16
+}
+
+func init() {
+	// The slave of /dev/pt/pN is /dev/tt/pN; SSH_TTY is /dev/ + this.
+	ptyName = func(f *os.File) (string, error) {
+		name, ok := strings.CutPrefix(f.Name(), "/dev/pt/")
+		if !ok {
+			return "", fmt.Errorf("not a pty master: %q", f.Name())
+		}
+		return "tt/" + name, nil
+	}
+}
+
+func execve(argv0 string, argv []string, envv []string) error {
+	return syscall.Exec(argv0, argv, envv)
+}
+
+// openPTY opens a pseudo-terminal pair the way posix_openpt, grantpt and
+// ptsname do in libroot. The master is named /dev/pt/<x>, the device it is,
+// so that ptyName can derive the slave's name from it.
+func openPTY() (ptyFile, tty *os.File, err error) {
+	fd, err := syscall.Open("/dev/ptmx", syscall.O_RDWR|syscall.O_NOCTTY|syscall.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, nil, &os.PathError{Op: "open", Path: "/dev/ptmx", Err: err}
+	}
+	if err := ioctl(fd, haikuB_IOCTL_GRANT_TTY, nil, 0); err != nil {
+		syscall.Close(fd)
+		return nil, nil, fmt.Errorf("grantpt: %w", err)
+	}
+	var index int32
+	if err := ioctl(fd, haikuB_IOCTL_GET_TTY_INDEX, unsafe.Pointer(&index), unsafe.Sizeof(index)); err != nil {
+		syscall.Close(fd)
+		return nil, nil, fmt.Errorf("ptsname: %w", err)
+	}
+	name := fmt.Sprintf("%c%x", 'p'+index/16, index%16)
+	ptyFile = os.NewFile(uintptr(fd), "/dev/pt/"+name)
+	tty, err = os.OpenFile("/dev/tt/"+name, os.O_RDWR|syscall.O_NOCTTY, 0)
+	if err != nil {
+		ptyFile.Close()
+		return nil, nil, err
+	}
+	return ptyFile, tty, nil
+}
+
+func setWinsize(fd int, win gliderssh.Window) {
+	ws := haikuWinsize{
+		Row:    uint16(win.Height),
+		Col:    uint16(win.Width),
+		Xpixel: uint16(win.WidthPixels),
+		Ypixel: uint16(win.HeightPixels),
+	}
+	ioctl(fd, haikuTIOCSWINSZ, unsafe.Pointer(&ws), unsafe.Sizeof(ws))
+}
+
+// The ssh terminal modes Haiku's termios has, by flag word.
+var (
+	haikuCC = map[uint8]int{
+		ssh.VINTR: 0, ssh.VQUIT: 1, ssh.VERASE: 2, ssh.VKILL: 3, ssh.VEOF: 4,
+		ssh.VEOL: 5, ssh.VEOL2: 6, ssh.VSWTCH: 7, ssh.VSTART: 8, ssh.VSTOP: 9,
+		ssh.VSUSP: 10,
+	}
+	haikuIflag = map[uint8]uint16{
+		ssh.IGNPAR: 0x04, ssh.PARMRK: 0x08, ssh.INPCK: 0x10, ssh.ISTRIP: 0x20,
+		ssh.INLCR: 0x40, ssh.IGNCR: 0x80, ssh.ICRNL: 0x100, ssh.IUCLC: 0x200,
+		ssh.IXON: 0x400, ssh.IXANY: 0x800, ssh.IXOFF: 0x1000,
+	}
+	haikuOflag = map[uint8]uint16{
+		ssh.OPOST: 0x01, ssh.OLCUC: 0x02, ssh.ONLCR: 0x04, ssh.OCRNL: 0x08,
+		ssh.ONOCR: 0x10, ssh.ONLRET: 0x20,
+	}
+	haikuCflag = map[uint8]uint16{
+		ssh.CS8: 0x20, ssh.PARENB: 0x100, ssh.PARODD: 0x200,
+	}
+	haikuLflag = map[uint8]uint16{
+		ssh.ISIG: 0x01, ssh.ICANON: 0x02, ssh.XCASE: 0x04, ssh.ECHO: 0x08,
+		ssh.ECHOE: 0x10, ssh.ECHOK: 0x20, ssh.ECHONL: 0x40, ssh.NOFLSH: 0x80,
+		ssh.TOSTOP: 0x100, ssh.IEXTEN: 0x200, ssh.ECHOCTL: 0x400,
+		ssh.ECHOKE: 0x1000, ssh.PENDIN: 0x4000,
+	}
+)
+
+// applyPTYModes applies the window size and terminal modes of ptyReq to the
+// tty open as fd. Modes Haiku's termios lacks, and the line speeds, are
+// ignored.
+func applyPTYModes(fd int, ptyReq *gliderssh.Pty, vlogf logger.Logf) error {
+	var t haikuTermios
+	if err := ioctl(fd, haikuTCGETA, unsafe.Pointer(&t), unsafe.Sizeof(t)); err != nil {
+		return fmt.Errorf("TCGETA: %w", err)
+	}
+	set := func(word *uint16, bit uint16, on bool) {
+		if on {
+			*word |= bit
+		} else {
+			*word &^= bit
+		}
+	}
+	for c, v := range ptyReq.Modes {
+		if i, ok := haikuCC[c]; ok {
+			t.CC[i] = uint8(v)
+		} else if b, ok := haikuIflag[c]; ok {
+			set(&t.Iflag, b, v != 0)
+		} else if b, ok := haikuOflag[c]; ok {
+			set(&t.Oflag, b, v != 0)
+		} else if b, ok := haikuCflag[c]; ok {
+			set(&t.Cflag, b, v != 0)
+		} else if b, ok := haikuLflag[c]; ok {
+			set(&t.Lflag, b, v != 0)
+		} else if c != ssh.TTY_OP_ISPEED && c != ssh.TTY_OP_OSPEED {
+			vlogf("unsupported opcode: %d=%v", c, v)
+		}
+	}
+	if err := ioctl(fd, haikuTCSETA, unsafe.Pointer(&t), unsafe.Sizeof(t)); err != nil {
+		return fmt.Errorf("TCSETA: %w", err)
+	}
+	setWinsize(fd, ptyReq.Window)
+	return nil
+}
diff --git a/ssh/tailssh/incubator_sys.go b/ssh/tailssh/incubator_sys.go
new file mode 100644
index 0000000..f73ca98
--- /dev/null
+++ b/ssh/tailssh/incubator_sys.go
@@ -0,0 +1,85 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build (linux && !android) || (darwin && !ios) || freebsd || openbsd
+
+package tailssh
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+
+	"github.com/creack/pty"
+	gliderssh "github.com/tailscale/gliderssh"
+	"github.com/u-root/u-root/pkg/termios"
+	"golang.org/x/crypto/ssh"
+	"golang.org/x/sys/unix"
+	"tailscale.com/types/logger"
+)
+
+// The OS-specific parts of the incubator: exec, PTY allocation and terminal
+// settings. Haiku has its own versions in incubator_haiku.go.
+
+func execve(argv0 string, argv []string, envv []string) error {
+	return unix.Exec(argv0, argv, envv)
+}
+
+func openPTY() (ptyFile, tty *os.File, err error) {
+	return pty.Open()
+}
+
+func setWinsize(fd int, win gliderssh.Window) {
+	unix.IoctlSetWinsize(fd, syscall.TIOCSWINSZ, &unix.Winsize{
+		Row:    uint16(win.Height),
+		Col:    uint16(win.Width),
+		Xpixel: uint16(win.WidthPixels),
+		Ypixel: uint16(win.HeightPixels),
+	})
+}
+
+// applyPTYModes applies the window size and terminal modes of ptyReq to the
+// tty open as fd.
+func applyPTYModes(fd int, ptyReq *gliderssh.Pty, vlogf logger.Logf) error {
+	// Load existing PTY settings to modify them & save them back.
+	tios, err := termios.GTTY(fd)
+	if err != nil {
+		return fmt.Errorf("GTTY: %w", err)
+	}
+
+	// Set the rows & cols to those advertised from the ptyReq frame
+	// received over SSH.
+	tios.Row = int(ptyReq.Window.Height)
+	tios.Col = int(ptyReq.Window.Width)
+
+	for c, v := range ptyReq.Modes {
+		if c == ssh.TTY_OP_ISPEED {
+			tios.Ispeed = int(v)
+			continue
+		}
+		if c == ssh.TTY_OP_OSPEED {
+			tios.Ospeed = int(v)
+			continue
+		}
+		k, ok := opcodeShortName[c]
+		if !ok {
+			vlogf("unknown opcode: %d", c)
+			continue
+		}
+		if _, ok := tios.CC[k]; ok {
+			tios.CC[k] = uint8(v)
+			continue
+		}
+		if _, ok := tios.Opts[k]; ok {
+			tios.Opts[k] = v > 0
+			continue
+		}
+		vlogf("unsupported opcode: %v(%d)=%v", k, c, v)
+	}
+
+	// Save PTY settings.
+	if _, err := tios.STTY(fd); err != nil {
+		return fmt.Errorf("STTY: %w", err)
+	}
+	return nil
+}
