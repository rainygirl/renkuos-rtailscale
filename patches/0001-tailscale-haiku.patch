diff --git a/net/netmon/interfaces_haiku.go b/net/netmon/interfaces_haiku.go
new file mode 100644
index 0000000..bbbd3c8
--- /dev/null
+++ b/net/netmon/interfaces_haiku.go
@@ -0,0 +1,64 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package netmon
+
+import (
+	"net"
+)
+
+// Go on Haiku has no interface enumeration: net.Interfaces returns an empty
+// list and a nil error. With no interfaces the monitor reports the network as
+// down, and netcheck then skips every STUN probe (it only probes address
+// families the interface state says exist), which leaves the node relay-only.
+//
+// Until the Go port grows a real implementation, ask the kernel which local
+// address it would use to reach a public destination. Connecting a UDP socket
+// performs that route lookup without sending a packet. The result is reported
+// as one synthetic interface per address family.
+func init() {
+	RegisterInterfaceGetter(haikuInterfaces)
+}
+
+// haikuProbes are the destinations used for the route lookup. Nothing is sent
+// to them.
+var haikuProbes = []struct {
+	network, dst string
+	bits         int
+}{
+	{"udp4", "1.1.1.1:53", 32},
+	{"udp6", "[2606:4700:4700::1111]:53", 128},
+}
+
+func haikuInterfaces() ([]Interface, error) {
+	var ret []Interface
+	for i, p := range haikuProbes {
+		c, err := net.Dial(p.network, p.dst)
+		if err != nil {
+			continue // no route for this address family
+		}
+		ua, ok := c.LocalAddr().(*net.UDPAddr)
+		c.Close()
+		if !ok || ua.IP.IsUnspecified() || ua.IP.IsLoopback() {
+			continue
+		}
+		name := "net4"
+		if p.bits == 128 {
+			name = "net6"
+		}
+		ret = append(ret, Interface{
+			Interface: &net.Interface{
+				Index: i + 1,
+				MTU:   1500,
+				Name:  name,
+				Flags: net.FlagUp | net.FlagRunning | net.FlagBroadcast | net.FlagMulticast,
+			},
+			// The prefix length is not known; a host route is the only
+			// claim that is certainly true.
+			AltAddrs: []net.Addr{&net.IPNet{IP: ua.IP, Mask: net.CIDRMask(p.bits, p.bits)}},
+		})
+	}
+	return ret, nil
+}
