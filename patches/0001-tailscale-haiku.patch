index 0000000..7e0af4a
--- /dev/null
+++ b/wgengine/router/osrouter/router_haiku.go
@@ -0,0 +1,321 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package osrouter
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"strings"
+
+	"github.com/tailscale/wireguard-go/tun"
+	"tailscale.com/net/netmon"
+	"tailscale.com/net/netns"
+	"tailscale.com/net/tsaddr"
+	"tailscale.com/types/logger"
+	"tailscale.com/wgengine/router"
+)
+
+func init() {
+	router.HookNewUserspaceRouter.Set(func(opts router.NewOpts) (router.Router, error) {
+		return newHaikuRouter(opts.Logf, opts.Tun)
+	})
+	router.HookCleanUp.Set(func(logf logger.Logf, _ *netmon.Monitor, ifName string) {
+		for _, name := range strings.Split(ifName, ",") {
+			switch {
+			case strings.HasPrefix(name, "tun/"):
+				haikuDown(logf, name)
+			case name == "tun":
+				// The daemon took the first free interface and nothing
+				// recorded which: take down the ones that carry a
+				// Tailscale address.
+				for i := 0; i < 10; i++ {
+					n := fmt.Sprintf("tun/%d", i)
+					if haikuHasTailscaleAddr(n) {
+						haikuDown(logf, n)
+					}
+				}
+			}
+		}
+	})
+}
+
+// haikuRouter configures a tun interface with Haiku's ifconfig and route.
+//
+// IPv4 is set up as before. IPv6 is set up on top of it, best effort: a
+// Haiku whose network stack has no IPv6 datalink for tunnel devices refuses
+// the address ("Invalid Argument"). Then the IPv6 address and routes are
+// left out, peers are reached by their IPv4 addresses, and IPv6 errors are
+// logged but never returned, so they cannot fail an IPv4 configuration.
+type haikuRouter struct {
+	logf    logger.Logf
+	tunname string
+	local   netip.Prefix
+	routes  map[netip.Prefix]bool
+	bypass  bool // netns.SetupBypass is in effect
+
+	local6  netip.Prefix          // IPv6 address set on the interface
+	routes6 map[netip.Prefix]bool // IPv6 routes set
+	failed6 netip.Addr            // IPv6 address the interface refused
+}
+
+func newHaikuRouter(logf logger.Logf, tundev tun.Device) (router.Router, error) {
+	tunname, err := tundev.Name()
+	if err != nil {
+		return nil, err
+	}
+	return &haikuRouter{logf: logf, tunname: tunname}, nil
+}
+
+func haikuRun(logf logger.Logf, args ...string) error {
+	out, err := exec.Command(args[0], args[1:]...).CombinedOutput()
+	if err != nil {
+		err = fmt.Errorf("%s: %v: %s", strings.Join(args, " "), err, strings.TrimSpace(string(out)))
+		logf("%v", err)
+	}
+	return err
+}
+
+// haikuDown takes a tun interface down, which also removes its routes. It
+// is deliberately not removed: see NativeTun.Close in wireguard-go.
+func haikuDown(logf logger.Logf, name string) {
+	if _, err := os.Stat("/dev/" + name); err != nil {
+		return // no such interface
+	}
+	haikuRun(logf, "ifconfig", name, "down")
+}
+
+// haikuHasTailscaleAddr reports whether ifconfig shows the interface with an
+// address in the range Tailscale assigns from.
+func haikuHasTailscaleAddr(name string) bool {
+	out, err := exec.Command("ifconfig", name).Output()
+	if err != nil {
+		return false
+	}
+	for _, f := range strings.FieldsFunc(string(out), func(r rune) bool {
+		return r == ' ' || r == ',' || r == '\n' || r == '\t'
+	}) {
+		if a, err := netip.ParseAddr(f); err == nil &&
+			(tsaddr.CGNATRange().Contains(a) || tsaddr.TailscaleULARange().Contains(a)) {
+			return true
+		}
+	}
+	return false
+}
+
+func haikuMask(p netip.Prefix) string {
+	return net.IP(net.CIDRMask(p.Bits(), 32)).String()
+}
+
+// haikuRun6 is haikuRun for IPv6 commands: failures are logged as IPv6 ones.
+func haikuRun6(logf logger.Logf, args ...string) error {
+	return haikuRun(func(format string, a ...any) {
+		logf("router: IPv6: "+format, a...)
+	}, args...)
+}
+
+func (r *haikuRouter) Up() error {
+	return haikuRun(r.logf, "ifconfig", r.tunname, "up")
+}
+
+func (r *haikuRouter) route(verb string, p netip.Prefix) error {
+	if p.Bits() == 0 {
+		// The default route of an exit node goes in as more specific
+		// routes: they win over the physical default route, which stays
+		// for the host routes that keep tailscaled's own traffic out of
+		// the tunnel. Not 0.0.0.0/1: route(8) takes any route to 0.0.0.0
+		// for a default route and drops the mask, so 0.0.0.0/8 (which is
+		// not routable anyway) is left out.
+		var errs []error
+		for _, h := range haikuDefaultHalves {
+			errs = append(errs, r.route(verb, h))
+		}
+		return errors.Join(errs...)
+	}
+	return haikuRun(r.logf, "route", verb, r.tunname, "inet",
+		p.Masked().Addr().String(), "netmask", haikuMask(p))
+}
+
+// haikuDefaultHalves covers 1.0.0.0 to 255.255.255.255.
+var haikuDefaultHalves = []netip.Prefix{
+	netip.MustParsePrefix("1.0.0.0/8"),
+	netip.MustParsePrefix("2.0.0.0/7"),
+	netip.MustParsePrefix("4.0.0.0/6"),
+	netip.MustParsePrefix("8.0.0.0/5"),
+	netip.MustParsePrefix("16.0.0.0/4"),
+	netip.MustParsePrefix("32.0.0.0/3"),
+	netip.MustParsePrefix("64.0.0.0/2"),
+	netip.MustParsePrefix("128.0.0.0/1"),
+}
+
+func (r *haikuRouter) route6(verb string, p netip.Prefix) error {
+	return haikuRun6(r.logf, "route", verb, r.tunname, "inet6",
+		p.Masked().Addr().String(), "prefixlen", fmt.Sprint(p.Bits()))
+}
+
+func (r *haikuRouter) Set(cfg *router.Config) (reterr error) {
+	if cfg == nil {
+		cfg = &shutdownConfig
+	}
+	setErr := func(err error) {
+		if err != nil && reterr == nil {
+			reterr = err
+		}
+	}
+
+	// An interface has one IPv4 address here; setting it replaces the old one.
+	var local netip.Prefix
+	for _, a := range cfg.LocalAddrs {
+		if a.Addr().Is4() {
+			local = a
+			break
+		}
+	}
+	addrChanged := local != r.local
+	if addrChanged {
+		if r.local.IsValid() && local.IsValid() {
+			// A different address: start from an interface without routes.
+			haikuRun(r.logf, "ifconfig", r.tunname, "down")
+			r.routes = nil
+			r.routes6 = nil
+		}
+		if local.IsValid() {
+			// The interface's own route covers only this address; every
+			// other destination is added below.
+			err := haikuRun(r.logf, "ifconfig", r.tunname, "inet",
+				local.Addr().String(), "netmask", "255.255.255.255", "up")
+			setErr(err)
+			if err == nil {
+				r.local = local
+			}
+		} else {
+			// Nothing left to be. Down takes the routes along; the
+			// address stays on the interface but means nothing there.
+			setErr(haikuRun(r.logf, "ifconfig", r.tunname, "down"))
+			r.local = netip.Prefix{}
+			r.routes = nil
+			r.routes6 = nil
+		}
+	}
+
+	want := make(map[netip.Prefix]bool)
+	if local.IsValid() {
+		for _, p := range cfg.Routes {
+			if p.Addr().Is4() && p.Masked() != local.Masked() {
+				want[p.Masked()] = true
+			}
+		}
+	}
+	def := netip.PrefixFrom(netip.IPv4Unspecified(), 0)
+	if want[def] && !r.bypass {
+		// Without the bypass the tunnel's own packets would loop into it.
+		if err := netns.SetupBypass(r.logf, r.tunname); err != nil {
+			setErr(err)
+			delete(want, def)
+		} else {
+			r.bypass = true
+		}
+	}
+	for p := range r.routes {
+		if !want[p] {
+			setErr(r.route("delete", p))
+		}
+	}
+	for p := range want {
+		if !r.routes[p] {
+			if err := r.route("add", p); err != nil {
+				setErr(err)
+				delete(want, p)
+			}
+		}
+	}
+	r.routes = want
+	if r.bypass && !want[def] {
+		netns.CleanupBypass(r.logf)
+		r.bypass = false
+	}
+
+	r.set6(cfg)
+	return reterr
+}
+
+// set6 sets the IPv6 address and routes. Its errors are only logged.
+func (r *haikuRouter) set6(cfg *router.Config) {
+	var local6 netip.Prefix
+	for _, a := range cfg.LocalAddrs {
+		if a.Addr().Is6() {
+			local6 = a
+			break
+		}
+	}
+
+	if local6 != r.local6 {
+		switch {
+		case local6.IsValid() && local6.Addr() == r.failed6:
+			// Refused before; asking again on every netmap change
+			// would only repeat the error.
+		case local6.IsValid():
+			// Setting an IPv6 address replaces the previous one.
+			err := haikuRun6(r.logf, "ifconfig", r.tunname, "inet6",
+				local6.Addr().String(), "prefixlen", "128", "up")
+			if err == nil {
+				r.local6 = local6
+				r.failed6 = netip.Addr{}
+			} else {
+				r.logf("router: IPv6: the tun interface refused %v; "+
+					"continuing with IPv4 only", local6.Addr())
+				if r.local6.IsValid() {
+					haikuRun6(r.logf, "ifconfig", "--delete", r.tunname,
+						"inet6", r.local6.Addr().String())
+				}
+				r.local6 = netip.Prefix{}
+				r.failed6 = local6.Addr()
+			}
+		default:
+			if r.local6.IsValid() {
+				haikuRun6(r.logf, "ifconfig", "--delete", r.tunname,
+					"inet6", r.local6.Addr().String())
+			}
+			r.local6 = netip.Prefix{}
+		}
+	}
+
+	want := make(map[netip.Prefix]bool)
+	if r.local6.IsValid() {
+		for _, p := range cfg.Routes {
+			if !p.Addr().Is6() || p.Masked() == r.local6.Masked() {
+				continue
+			}
+			if p.Bits() == 0 {
+				// An IPv6 default route (exit node) would also take
+				// tailscaled's own IPv6 traffic into the tunnel:
+				// there is no IPv6 bypass, so it is left out.
+				continue
+			}
+			want[p.Masked()] = true
+		}
+	}
+	for p := range r.routes6 {
+		if !want[p] {
+			r.route6("delete", p)
+		}
+	}
+	for p := range want {
+		if !r.routes6[p] {
+			if err := r.route6("add", p); err != nil {
+				delete(want, p)
+			}
+		}
+	}
+	r.routes6 = want
+}
+
+func (r *haikuRouter) Close() error {
+	return r.Set(nil)
+}
