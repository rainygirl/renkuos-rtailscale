+// NewOSConfigurator creates a new OS configurator.
+//
+// Haiku's resolver reads the resolv.conf that net_server keeps in the
+// network settings directory (see resolvconfpath_haiku.go), so the file is
+// replaced directly, with a backup beside it. net_server rewrites the file
+// when an interface is reconfigured, which undoes the change until the next
+// time tailscaled applies its DNS configuration.
+func NewOSConfigurator(logf logger.Logf, health *health.Tracker, bus *eventbus.Bus, _ policyclient.Client, _ *controlknobs.Knobs, _ string) (OSConfigurator, error) {
+	return newDirectManager(logf, health, bus), nil
+}
