diff --git a/client/local/nonblock_haiku.go b/client/local/nonblock_haiku.go
new file mode 100644
index 0000000..719019c
--- /dev/null
+++ b/client/local/nonblock_haiku.go
@@ -0,0 +1,29 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package local
+
+import "net"
+
+// wrapHaikuNonblocking is a no-op, and three separate attempts to make it
+// something else have all made the Haiku/386 build worse. Do not try a fourth
+// without a new idea.
+//
+//  1. An EAGAIN retry loop that also forced the fd non-blocking: raced the
+//     poller and stalled `tailscale status` about half the time.
+//  2. A blocking dup via net.FileConn: came back non-blocking but unregistered
+//     with the poller, so reads surfaced raw "operation would block" errors to
+//     net/http.
+//  3. A deadline re-arm wrapper around Read and Write, mirroring the daemon's
+//     haikuAPIConn (which does help on the daemon's accepted connections).
+//     Here it stopped requests reaching the daemon at all: zero `localapi:`
+//     lines in the daemon log, so every command hung and `up` never reached
+//     Running. The client conn is driven by net/http's own read and write
+//     loops, which manage deadlines themselves; a second layer doing the same
+//     thing fights them.
+//
+// The client-side protection that does work lives above the connection, in
+// DoLocalRequest's retry (see doHaikuWithRetry).
+func wrapHaikuNonblocking(c net.Conn) (net.Conn, error) { return c, nil }
