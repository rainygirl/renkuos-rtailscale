+
+// runNCHaiku uses an explicit copy loop instead of io.Copy. The Haiku/386 Go
+// port has no network poller, and io.Copy's file/connection fast paths can
+// leave the ProxyCommand process blocked after forwarding only the first byte
+// of an SSH identification string.
+func runNCHaiku(c net.Conn) error {
+	restorePipes, err := prepareNCHaikuPipes()
+	if err != nil {
+		return fmt.Errorf("preparing Haiku ProxyCommand pipes: %w", err)
+	}
+	defer restorePipes()
+
+	errc := make(chan error, 2)
+	go func() {
+		errc <- copyNCHaiku(os.Stdout, c, "peer-to-stdout")
+	}()
+
+	// Let the server-to-stdout pump enter its Read before starting the stdin
+	// pump. SSH waits for the server identification before sending the rest of
+	// its own identification, so this ordering avoids a two-sided startup
+	// stall on the single-core Haiku/386 scheduler.
+	runtime.Gosched()
+
+	go func() {
+		errc <- copyNCHaiku(c, os.Stdin, "stdin-to-peer")
+	}()
+	return <-errc
+}
+
+func copyNCHaiku(dst io.Writer, src io.Reader, direction string) error {
+	buf := make([]byte, 4<<10)
+	firstRead := true
+	firstWrite := true
+	fmt.Fprintf(os.Stderr, "tailscale nc (Haiku): %s pump entered\n", direction)
+	for {
+		nr, readErr := src.Read(buf)
+		if nr > 0 {
+			if firstRead {
+				firstRead = false
+				fmt.Fprintf(os.Stderr, "tailscale nc (Haiku): %s received first %d bytes\n", direction, nr)
+			}
+			for off := 0; off < nr; {
+				nw, writeErr := dst.Write(buf[off:nr])
+				if nw > 0 {
+					off += nw
+					if firstWrite {
+						firstWrite = false
+						fmt.Fprintf(os.Stderr, "tailscale nc (Haiku): %s forwarded first %d bytes\n", direction, nw)
+					}
+				}
+				if writeErr != nil {
+					if retryNCHaikuIO(writeErr) {
+						time.Sleep(2 * time.Millisecond)
+						continue
+					}
+					return writeErr
+				}
+				if nw == 0 {
+					return io.ErrNoProgress
+				}
+				runtime.Gosched()
+			}
+		}
+		if readErr != nil {
+			if retryNCHaikuIO(readErr) {
+				time.Sleep(2 * time.Millisecond)
+				continue
+			}
+			if errors.Is(readErr, io.EOF) {
+				return nil
+			}
+			return readErr
+		}
+		runtime.Gosched()
+	}
+}
+
+func retryNCHaikuIO(err error) bool {
+	if err == nil {
+		return false
+	}
+	if ne, ok := err.(net.Error); ok && (ne.Timeout() || ne.Temporary()) {
+		return true
+	}
+	type temporary interface {
+		Temporary() bool
+	}
+	if te, ok := err.(temporary); ok && te.Temporary() {
+		return true
+	}
+	// Non-blocking pipe/socket I/O (the ProxyCommand stdin/stdout pipes and the
+	// Haiku sockets) surfaces EAGAIN/EWOULDBLOCK when no data or space is
+	// momentarily available. On Haiku these arrive wrapped in *os.PathError /
+	// *os.SyscallError, which implement neither net.Error nor Temporary(), so
+	// the type assertions above miss them. Match the errno directly and retry;
+	// otherwise a transient "operation would block" tears down the connection
+	// mid-transfer (e.g. right after ssh's first 22-byte identification).
+	return errors.Is(err, syscall.EAGAIN) || errors.Is(err, syscall.EWOULDBLOCK)
+}
diff --git a/cmd/tailscale/cli/nc_nonblock_haiku.go b/cmd/tailscale/cli/nc_nonblock_haiku.go
new file mode 100644
index 0000000..4302185
--- /dev/null
+++ b/cmd/tailscale/cli/nc_nonblock_haiku.go
@@ -0,0 +1,41 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package cli
+
+import (
+	"fmt"
+	"os"
+	"syscall"
+)
+
+// prepareNCHaikuPipes makes only pipe-backed stdin/stdout non-blocking. This
+// is the ProxyCommand case. A terminal is deliberately left unchanged because
+// O_NONBLOCK belongs to the shared open file description and could otherwise
+// affect the invoking shell.
+func prepareNCHaikuPipes() (func(), error) {
+	var changed []*os.File
+	for _, f := range []*os.File{os.Stdin, os.Stdout} {
+		fi, err := f.Stat()
+		if err != nil {
+			return func() {}, err
+		}
+		if fi.Mode()&os.ModeNamedPipe == 0 {
+			continue
+		}
+		if err := syscall.SetNonblock(int(f.Fd()), true); err != nil {
+			for _, old := range changed {
+				_ = syscall.SetNonblock(int(old.Fd()), false)
+			}
+			return func() {}, fmt.Errorf("fd %d: %w", f.Fd(), err)
+		}
+		changed = append(changed, f)
+	}
+	return func() {
+		for _, f := range changed {
+			_ = syscall.SetNonblock(int(f.Fd()), false)
+		}
+	}, nil
+}
