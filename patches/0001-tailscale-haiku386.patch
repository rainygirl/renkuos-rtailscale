index 0000000..bab9dfa
--- /dev/null
+++ b/ipn/localapi/nonblock_haiku.go
@@ -0,0 +1,34 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package localapi
+
+import (
+	"errors"
+	"net"
+	"syscall"
+)
+
+// setHaikuNonblocking switches the hijacked LocalAPI socket to explicit
+// non-blocking I/O. The Haiku/386 Go port cannot register sockets with the
+// runtime netpoller, and SO_RCVTIMEO does not reliably wake a connected Unix
+// socket after its first read.
+func setHaikuNonblocking(c net.Conn) error {
+	sc, ok := c.(syscall.Conn)
+	if !ok {
+		return errors.New("connection does not expose syscall.Conn")
+	}
+	raw, err := sc.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var setErr error
+	if err := raw.Control(func(fd uintptr) {
+		setErr = syscall.SetNonblock(int(fd), true)
+	}); err != nil {
+		return err
+	}
+	return setErr
+}
