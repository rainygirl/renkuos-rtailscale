@@ -10,0 +11 @@ import (
+	"runtime"
@@ -159,0 +161,27 @@ func setDeadlineImpl(fd *FD, t time.Time, mode int) error {
+		if runtime.GOOS == "haiku" && !fd.isFile {
+			// Haiku/386 sockets run in blocking mode because the runtime
+			// poller is unavailable. Enforce deadlines in the kernel so an
+			// unresponsive DNS or control server cannot hold an OS thread
+			// forever.
+			var tv syscall.Timeval
+			if d != 0 {
+				if d < 0 {
+					d = 1
+				}
+				tv = syscall.NsecToTimeval(d)
+				if tv.Sec == 0 && tv.Usec == 0 {
+					tv.Usec = 1
+				}
+			}
+			if mode&'r' != 0 {
+				if err := syscall.SetsockoptTimeval(fd.Sysfd, syscall.SOL_SOCKET, syscall.SO_RCVTIMEO, &tv); err != nil {
+					return err
+				}
+			}
+			if mode&'w' != 0 {
+				if err := syscall.SetsockoptTimeval(fd.Sysfd, syscall.SOL_SOCKET, syscall.SO_SNDTIMEO, &tv); err != nil {
+					return err
+				}
+			}
+			return nil
+		}
