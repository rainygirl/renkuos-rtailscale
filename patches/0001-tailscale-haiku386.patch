+// copyHaikuDialConn copies one half of a LocalAPI dial tunnel. wakeSrc and
+// wakeDst identify real Haiku sockets whose blocking syscalls need periodic
+// kernel deadlines. They must be false for gVisor gonet connections: those
+// connections already use scheduler-friendly waiter channels, and repeatedly
+// expiring their time.AfterFunc deadlines can discard a packet notification.
+func copyHaikuDialConn(dst, src net.Conn, wakeDst, wakeSrc bool, logf logger.Logf, direction string) (written int64, retErr error) {
+	const wakeInterval = time.Second
+	if logf == nil {
+		logf = logger.Discard
+	}
+	buf := make([]byte, 32<<10)
+	logf("localapi dial: %s pump entered (wakeSrc=%v, wakeDst=%v)", direction, wakeSrc, wakeDst)
+	firstData := true
+	firstWrite := true
+	readTimeouts := 0
+	writeTimeouts := 0
+	for {
+		if wakeSrc {
+			_ = src.SetReadDeadline(time.Now().Add(wakeInterval))
+		}
+		nr, readErr := src.Read(buf)
+		if nr > 0 {
+			readTimeouts = 0
+			if firstData {
+				firstData = false
+				logf("localapi dial: %s received first %d bytes", direction, nr)
+			}
+			for off := 0; off < nr; {
+				if wakeDst {
+					_ = dst.SetWriteDeadline(time.Now().Add(wakeInterval))
+				}
+				nw, writeErr := dst.Write(buf[off:nr])
+				if nw > 0 {
+					off += nw
+					written += int64(nw)
+					writeTimeouts = 0
+					if firstWrite {
+						firstWrite = false
+						logf("localapi dial: %s forwarded first %d bytes", direction, nw)
+					}
+				}
+				if writeErr != nil {
+					if retryHaikuIO(writeErr) {
+						writeTimeouts++
+						if writeTimeouts%500 == 0 {
+							logf("localapi dial: %s write still blocked after %v", direction, time.Duration(writeTimeouts)*10*time.Millisecond)
+						}
+						time.Sleep(10 * time.Millisecond)
+						continue
+					}
+					return written, writeErr
+				}
+				if nw == 0 {
+					return written, io.ErrNoProgress
+				}
+			}
+		}
+		if readErr != nil {
+			if retryHaikuIO(readErr) {
+				readTimeouts++
+				if readTimeouts%500 == 0 {
+					logf("localapi dial: %s read idle for %v", direction, time.Duration(readTimeouts)*10*time.Millisecond)
+				}
+				time.Sleep(10 * time.Millisecond)
+				continue
+			}
+			if errors.Is(readErr, io.EOF) {
+				return written, nil
+			}
+			return written, readErr
+		}
+	}
+}
+
+func retryHaikuIO(err error) bool {
+	if ne, ok := err.(net.Error); ok && (ne.Timeout() || ne.Temporary()) {
+		return true
+	}
+	type temporary interface {
+		Temporary() bool
+	}
+	te, ok := err.(temporary)
+	return ok && te.Temporary()
+}
