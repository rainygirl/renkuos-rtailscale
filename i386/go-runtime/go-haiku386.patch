+#include "textflag.h"
+
+TEXT _rt0_386_haiku(SB),NOSPLIT,$0
+	// Haiku's runtime_loader calls the ELF entry point using the 32-bit C
+	// ABI. Drop its return address so rt0_go sees argc and argv at 0(SP)
+	// and 4(SP), respectively.
+	ADDL	$4, SP
+	JMP	runtime·rt0_go(SB)
+
+TEXT _rt0_386_haiku_lib(SB),NOSPLIT,$0
+	JMP	_rt0_386_lib(SB)
+
+TEXT main(SB),NOSPLIT,$0
+	ADDL	$4, SP
+	JMP	runtime·rt0_go(SB)
