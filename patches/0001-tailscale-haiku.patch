new file mode 100644
index 0000000..c6d5dc0
--- /dev/null
+++ b/net/dns/watchfile_haiku.go
@@ -0,0 +1,46 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package dns
+
+import (
+	"context"
+	"os"
+	"time"
+)
+
+// net_server rewrites resolv.conf whenever DHCP configures an interface,
+// including at every lease renewal, which silently drops the tailnet's
+// resolver. Watch the file so the manager notices and puts its own
+// configuration back, as it does on Linux with inotify. A stat every two
+// seconds is cheaper than it sounds and needs no node monitor port.
+func init() {
+	HookWatchFile.Set(watchFileByStat)
+}
+
+func watchFileByStat(ctx context.Context, _, filename string, cb func()) error {
+	t := time.NewTicker(2 * time.Second)
+	defer t.Stop()
+	last, _ := os.Stat(filename)
+	for {
+		select {
+		case <-ctx.Done():
+			return nil // closed; not worth a log line
+		case <-t.C:
+		}
+		cur, _ := os.Stat(filename)
+		if !sameFileState(last, cur) {
+			cb()
+		}
+		last = cur
+	}
+}
+
+func sameFileState(a, b os.FileInfo) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return os.SameFile(a, b) && a.Size() == b.Size() && a.ModTime().Equal(b.ModTime())
+}
