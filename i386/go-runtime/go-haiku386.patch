index 0000000..0cf3485
--- /dev/null
+++ b/src/runtime/sys_haiku_386.s
@@ -0,0 +1,158 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "go_asm.h"
+#include "go_tls.h"
+#include "textflag.h"
+
+TEXT runtime·settls(SB),NOSPLIT,$0
+	RET
+
+// Haiku owns FS. Slot 63 is reserved for runtimes and stores &m.tls.
+TEXT runtime·setldt(SB),NOSPLIT,$0-12
+	MOVL	base+4(FP), AX
+	MOVL	AX, 0xfc(FS)
+	RET
+
+// C ABI entry point called through asmcgocall. Its argument is _errnop.
+TEXT runtime·miniterrno(SB),NOSPLIT,$0
+	MOVL	4(SP), AX
+	CALL	AX
+	get_tls(CX)
+	MOVL	g(CX), BX
+	MOVL	g_m(BX), BX
+	MOVL	AX, (m_mOS+mOS_perrno)(BX)
+	RET
+
+TEXT runtime·pipe1(SB),NOSPLIT,$0
+	SUBL	$8, SP
+	MOVL	SP, AX
+	MOVL	AX, 0(SP)
+	MOVL	$libc_pipe(SB), AX
+	CALL	AX
+	MOVL	0(SP), AX
+	MOVL	4(SP), DX
+	ADDL	$8, SP
+	RET
+
+TEXT runtime·sigfwd(SB),NOSPLIT,$12-16
+	MOVL	fn+0(FP), AX
+	MOVL	sig+4(FP), BX
+	MOVL	info+8(FP), CX
+	MOVL	ctx+12(FP), DX
+	MOVL	SP, SI
+	SUBL	$32, SP
+	ANDL	$~15, SP
+	MOVL	BX, 0(SP)
+	MOVL	CX, 4(SP)
+	MOVL	DX, 8(SP)
+	MOVL	SI, 12(SP)
+	CALL	AX
+	MOVL	12(SP), AX
+	MOVL	AX, SP
+	RET
+
+// Runs on the OS stack, called from runtime.osyield.
+TEXT runtime·osyield1(SB),NOSPLIT,$0
+	SUBL	$8, SP
+	MOVL	$0, 0(SP)
+	MOVL	$0, 4(SP)
+	MOVL	$libc_snooze(SB), AX
+	CALL	AX
+	ADDL	$8, SP
+	RET
+
+// Call a libroot function using the 32-bit SysV cdecl ABI.
+// Called through asmcgocall with *libcall at 4(SP).
+TEXT runtime·asmsysvicall6(SB),NOSPLIT,$0
+	PUSHL	BP
+	PUSHL	BX
+	PUSHL	SI
+	PUSHL	DI
+	MOVL	20(SP), DI
+	MOVL	libcall_fn(DI), AX
+	MOVL	libcall_args(DI), SI
+
+	get_tls(CX)
+	MOVL	g(CX), BX
+	CMPL	BX, $0
+	JEQ	args
+	MOVL	g_m(BX), BX
+	MOVL	(m_mOS+mOS_perrno)(BX), DX
+	CMPL	DX, $0
+	JEQ	args
+	MOVL	$0, 0(DX)
+
+args:
+	SUBL	$24, SP
+	CMPL	SI, $0
+	JEQ	call
+	MOVL	0(SI), CX
+	MOVL	CX, 0(SP)
+	MOVL	4(SI), CX
+	MOVL	CX, 4(SP)
+	MOVL	8(SI), CX
+	MOVL	CX, 8(SP)
+	MOVL	12(SI), CX
+	MOVL	CX, 12(SP)
+	MOVL	16(SI), CX
+	MOVL	CX, 16(SP)
+	MOVL	20(SI), CX
+	MOVL	CX, 20(SP)
+call:
+	CALL	AX
+	ADDL	$24, SP
+	MOVL	AX, libcall_r1(DI)
+	MOVL	DX, libcall_r2(DI)
+
+	get_tls(CX)
+	MOVL	g(CX), BX
+	CMPL	BX, $0
+	JEQ	done
+	MOVL	g_m(BX), BX
+	MOVL	(m_mOS+mOS_perrno)(BX), CX
+	CMPL	CX, $0
+	JEQ	done
+	MOVL	0(CX), AX
+	MOVL	AX, libcall_err(DI)
+done:
+	POPL	DI
+	POPL	SI
+	POPL	BX
+	POPL	BP
+	RET
+
+// pthread start routine, using the 32-bit SysV C ABI.
+TEXT runtime·tstart_sysvicall(SB),NOSPLIT,$0
+	MOVL	4(SP), AX
+	MOVL	m_g0(AX), BX
+	LEAL	m_tls(AX), CX
+	MOVL	CX, 0xfc(FS)
+	get_tls(CX)
+	MOVL	BX, g(CX)
+	MOVL	AX, g_m(BX)
+	MOVL	SP, DX
+	MOVL	DX, (g_stack+stack_hi)(BX)
+	SUBL	$(0x100000), DX
+	MOVL	DX, (g_stack+stack_lo)(BX)
+	ADDL	$const_stackGuard, DX
+	MOVL	DX, g_stackguard0(BX)
+	MOVL	DX, g_stackguard1(BX)
+	CLD
+	CALL	runtime·stackcheck(SB)
+	CALL	runtime·mstart(SB)
+	XORL	AX, AX
+	RET
+
+// Haiku invokes SA_SIGINFO handlers using the cdecl ABI.
+TEXT runtime·sigtramp(SB),NOSPLIT|TOPFRAME,$12
+	NOP	SP
+	MOVL	16(SP), AX
+	MOVL	AX, 0(SP)
+	MOVL	20(SP), AX
+	MOVL	AX, 4(SP)
+	MOVL	24(SP), AX
+	MOVL	AX, 8(SP)
+	CALL	runtime·sigtrampgo(SB)
+	RET
