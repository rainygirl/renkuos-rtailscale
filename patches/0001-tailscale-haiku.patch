diff --git a/net/netns/netns_haiku.go b/net/netns/netns_haiku.go
new file mode 100644
index 0000000..c96ce7c
--- /dev/null
+++ b/net/netns/netns_haiku.go
@@ -0,0 +1,202 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package netns
+
+import (
+	"fmt"
+	"net"
+	"net/netip"
+	"os/exec"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+
+	"tailscale.com/net/netmon"
+	"tailscale.com/types/logger"
+)
+
+// Haiku has one routing table, no policy routing and no socket marks, and
+// SO_BINDTODEVICE sends straight onto the link without a gateway. So when
+// an exit node is in use and the default route points into the tunnel,
+// tailscaled's own traffic (control, DERP, STUN, WireGuard to peers) is kept
+// out of it with host routes through the physical gateway: one for each
+// remote address tailscaled talks to, added before the first packet goes
+// out. The router turns this on with SetupBypass when it installs the
+// default route and off with CleanupBypass, which removes those routes.
+
+type haikuBypass struct {
+	logf   logger.Logf
+	ifname string         // physical interface, e.g. /dev/net/virtio/0
+	gw     netip.Addr     // its default gateway
+	lan    []netip.Prefix // on-link prefixes, which need no host route
+	pinned sync.Map       // netip.Addr -> bool (true: host route added)
+}
+
+var (
+	bypassMu sync.Mutex // serializes setup, cleanup and route additions
+	bypass   atomic.Pointer[haikuBypass]
+
+	// dialed records the remote addresses dialed through this package, so
+	// that connections made before SetupBypass get their routes too.
+	dialed sync.Map // netip.Addr -> struct{}
+)
+
+func control(logf logger.Logf, _ *netmon.Monitor) func(network, address string, c syscall.RawConn) error {
+	return controlC
+}
+
+// controlC pins the remote address of a dial. For a listen the address is
+// the local one and pins nothing.
+func controlC(network, address string, c syscall.RawConn) error {
+	if isLocalhost(address) {
+		return nil
+	}
+	if ap, err := netip.ParseAddrPort(address); err == nil {
+		a := ap.Addr().Unmap()
+		if a.Is4() && !a.IsUnspecified() {
+			dialed.Store(a, struct{}{})
+			PinBypassRoute(a)
+		}
+	}
+	return nil
+}
+
+func UseSocketMark() bool {
+	return false
+}
+
+// PinBypassRoute makes sure that packets to a are routed through the
+// physical gateway while the default route goes through the tunnel. It
+// does nothing otherwise, and costs one atomic load then.
+func PinBypassRoute(a netip.Addr) {
+	b := bypass.Load()
+	if b == nil || !a.Is4() {
+		return
+	}
+	if _, ok := b.pinned.Load(a); ok {
+		return
+	}
+	bypassMu.Lock()
+	defer bypassMu.Unlock()
+	if bypass.Load() != b {
+		return // cleaned up meanwhile
+	}
+	if _, ok := b.pinned.Load(a); ok {
+		return
+	}
+	if !b.needsRoute(a) {
+		b.pinned.Store(a, false)
+		return
+	}
+	err := haikuRoute("add", b.ifname, a.String(), "netmask", "255.255.255.255", "gw", b.gw.String())
+	if err != nil {
+		b.logf("netns: %v", err)
+	}
+	// Stored on failure too: retrying on every packet would not help.
+	b.pinned.Store(a, err == nil)
+}
+
+func (b *haikuBypass) needsRoute(a netip.Addr) bool {
+	if a.IsLoopback() || a.IsMulticast() || a.IsLinkLocalUnicast() || a == b.gw {
+		return false
+	}
+	// Tailscale's own range (100.64.0.0/10) is the tunnel's business.
+	if netip.MustParsePrefix("100.64.0.0/10").Contains(a) {
+		return false
+	}
+	for _, p := range b.lan {
+		if p.Contains(a) {
+			return false
+		}
+	}
+	return true
+}
+
+// haikuRoute runs Haiku's route command. route prints its errors but exits
+// with status 0, so its output is what tells.
+func haikuRoute(args ...string) error {
+	out, err := exec.Command("route", args...).CombinedOutput()
+	if err == nil && strings.Contains(string(out), "Could not") {
+		err = fmt.Errorf("failed")
+	}
+	if err != nil {
+		return fmt.Errorf("route %s: %v: %s", strings.Join(args, " "), err, strings.TrimSpace(string(out)))
+	}
+	return nil
+}
+
+// SetupBypass is called by the router before it routes the default route
+// through the tun interface tunname. It finds the current default gateway
+// and pins every address tailscaled has dialed so far.
+func SetupBypass(logf logger.Logf, tunname string) error {
+	bypassMu.Lock()
+	if bypass.Load() != nil {
+		bypassMu.Unlock()
+		return nil
+	}
+	out, err := exec.Command("route", "list", "inet").CombinedOutput()
+	if err != nil {
+		bypassMu.Unlock()
+		return fmt.Errorf("route list: %v", err)
+	}
+	b := &haikuBypass{logf: logf}
+	// Lines are: destination netmask gateway flags interface; the gateway is
+	// "-" for an on-link route.
+	for _, line := range strings.Split(string(out), "\n") {
+		f := strings.Fields(line)
+		if len(f) != 5 || f[4] == tunname || strings.HasPrefix(f[4], "tun/") || f[4] == "loop" {
+			continue
+		}
+		dst, err1 := netip.ParseAddr(f[0])
+		mask := net.ParseIP(f[1]).To4()
+		if err1 != nil || mask == nil {
+			continue
+		}
+		bits, _ := net.IPMask(mask).Size()
+		gw, err2 := netip.ParseAddr(f[2])
+		switch {
+		case bits == 0 && err2 == nil && !b.gw.IsValid():
+			b.ifname, b.gw = f[4], gw
+		case bits > 0 && err2 != nil:
+			b.lan = append(b.lan, netip.PrefixFrom(dst, bits).Masked())
+		}
+	}
+	if !b.gw.IsValid() {
+		bypassMu.Unlock()
+		return fmt.Errorf("no default gateway outside the tunnel in %q", out)
+	}
+	bypass.Store(b)
+	bypassMu.Unlock()
+	logf("netns: tailscaled's own traffic bypasses the tunnel via %v on %s (on-link: %v)", b.gw, b.ifname, b.lan)
+
+	dialed.Range(func(k, _ any) bool {
+		PinBypassRoute(k.(netip.Addr))
+		return true
+	})
+	return nil
+}
+
+// CleanupBypass removes the host routes added since SetupBypass.
+func CleanupBypass(logf logger.Logf) {
+	bypassMu.Lock()
+	defer bypassMu.Unlock()
+	b := bypass.Swap(nil)
+	if b == nil {
+		return
+	}
+	n := 0
+	b.pinned.Range(func(k, v any) bool {
+		if v.(bool) {
+			if err := haikuRoute("delete", b.ifname, k.(netip.Addr).String(), "netmask", "255.255.255.255", "gw", b.gw.String()); err != nil {
+				logf("netns: %v", err)
+			}
+			n++
+		}
+		return true
+	})
+	logf("netns: bypass via %v removed (%d host routes)", b.gw, n)
+}
