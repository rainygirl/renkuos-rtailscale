diff --git a/net/netmon/sys_haiku.go b/net/netmon/sys_haiku.go
new file mode 100644
index 0000000..7b14b09
--- /dev/null
+++ b/net/netmon/sys_haiku.go
@@ -0,0 +1,97 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package netmon
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+// Haiku has no netlink or routing socket, and Go's syscall package for
+// Haiku offers neither ioctl nor ports. Both are plain functions in
+// libroot.so, which every Go binary on Haiku already links against, so they
+// are called the way golang.org/x/sys/unix calls libc on Solaris: through
+// syscall's sysvicall6, without cgo.
+
+//go:cgo_import_dynamic libc___ioctl __ioctl "libroot.so"
+//go:cgo_import_dynamic libc_create_port create_port "libroot.so"
+//go:cgo_import_dynamic libc_read_port_etc read_port_etc "libroot.so"
+//go:cgo_import_dynamic libc_delete_port delete_port "libroot.so"
+//go:cgo_import_dynamic libc__kern_generic_syscall _kern_generic_syscall "libroot.so"
+
+//go:linkname libc___ioctl libc___ioctl
+//go:linkname libc_create_port libc_create_port
+//go:linkname libc_read_port_etc libc_read_port_etc
+//go:linkname libc_delete_port libc_delete_port
+//go:linkname libc__kern_generic_syscall libc__kern_generic_syscall
+
+var (
+	libc___ioctl,
+	libc_create_port,
+	libc_read_port_etc,
+	libc_delete_port,
+	libc__kern_generic_syscall libcFunc
+)
+
+type libcFunc uintptr
+
+//go:linkname sysvicall6 syscall.sysvicall6
+func sysvicall6(fn, nargs, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err syscall.Errno)
+
+func (f *libcFunc) call(nargs uintptr, a ...uintptr) (uintptr, syscall.Errno) {
+	var v [6]uintptr
+	copy(v[:], a)
+	r, _, e := sysvicall6(uintptr(unsafe.Pointer(f)), nargs, v[0], v[1], v[2], v[3], v[4], v[5])
+	return r, e
+}
+
+// ioctl calls __ioctl(fd, op, arg, size), which returns -1 and sets errno
+// on failure.
+func ioctl(fd int, op uintptr, arg unsafe.Pointer, size uintptr) error {
+	r, e := libc___ioctl.call(4, uintptr(fd), op, uintptr(arg), size)
+	if int32(r) == -1 {
+		return e
+	}
+	return nil
+}
+
+// Kernel calls return a negative status_t on failure.
+type haikuStatus int32
+
+func (s haikuStatus) Error() string { return syscall.Errno(s).Error() }
+
+func status(r uintptr) error {
+	if int32(r) < 0 {
+		return haikuStatus(int32(r))
+	}
+	return nil
+}
+
+func createPort(capacity int32, name string) (int32, error) {
+	b := append([]byte(name), 0)
+	r, _ := libc_create_port.call(2, uintptr(capacity), uintptr(unsafe.Pointer(&b[0])))
+	return int32(r), status(r)
+}
+
+// readPort blocks until a message arrives or the port is deleted.
+func readPort(port int32, buf []byte) (int, error) {
+	var code int32
+	r, _ := libc_read_port_etc.call(6, uintptr(port), uintptr(unsafe.Pointer(&code)),
+		uintptr(unsafe.Pointer(&buf[0])), uintptr(len(buf)), 0, 0)
+	return int(int32(r)), status(r)
+}
+
+func deletePort(port int32) error {
+	r, _ := libc_delete_port.call(1, uintptr(port))
+	return status(r)
+}
+
+func genericSyscall(subsystem string, function uint32, buf unsafe.Pointer, size uintptr) error {
+	b := append([]byte(subsystem), 0)
+	r, _ := libc__kern_generic_syscall.call(4, uintptr(unsafe.Pointer(&b[0])),
+		uintptr(function), uintptr(buf), size)
+	return status(r)
+}
