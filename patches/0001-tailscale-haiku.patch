@@ -0,0 +1,113 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package netmon
+
+import (
+	"errors"
+	"sync"
+	"time"
+	"unsafe"
+
+	"tailscale.com/types/logger"
+	"tailscale.com/util/eventbus"
+)
+
+// The network stack's notification module (<net/NetworkNotifications.h>,
+// private/net/net_notifications.h) sends a message to a port whenever an
+// interface is added, removed or changed (addresses, flags) and when a
+// device's link goes up or down. BNetworkRoster users subscribe through
+// start_watching_network(), a thin wrapper around this generic syscall.
+const (
+	netNotificationsSyscalls = "network/notifications"
+	netNotificationsWatching = 1
+
+	watchInterfaceChanges = 0x000f // B_WATCH_NETWORK_INTERFACE_CHANGES
+	watchLinkChanges      = 0x00f0 // B_WATCH_NETWORK_LINK_CHANGES
+)
+
+// haikuPollInterval is how often the state is checked without a
+// notification. Routes have no notifications (a default route that moves to
+// another interface is only seen this way), and if subscribing fails this is
+// the only source.
+const haikuPollInterval = 5 * time.Second
+
+func newOSMon(_ *eventbus.Bus, logf logger.Logf, m *Monitor) (osMon, error) {
+	hm := &haikuMon{logf: logf, port: -1, stop: make(chan struct{}), events: make(chan struct{}, 1)}
+	port, err := createPort(16, "tailscale netmon")
+	if err == nil {
+		ctl := struct {
+			flags uint32
+			port  int32
+			token uint32
+		}{watchInterfaceChanges | watchLinkChanges, port, 0}
+		err = genericSyscall(netNotificationsSyscalls, netNotificationsWatching,
+			unsafe.Pointer(&ctl), unsafe.Sizeof(ctl))
+		if err != nil {
+			deletePort(port)
+		} else {
+			hm.port = port
+			go hm.readPort()
+		}
+	}
+	if err != nil {
+		logf("network notifications unavailable, polling only: %v", err)
+	}
+	return hm, nil
+}
+
+type haikuMon struct {
+	logf   logger.Logf
+	port   int32 // -1 if not subscribed
+	events chan struct{}
+
+	closeOnce sync.Once
+	stop      chan struct{}
+}
+
+// readPort turns each notification into a wakeup. The messages are not
+// decoded: the monitor compares the whole state anyway, and a burst of them
+// (an interface going down drops several addresses) collapses into one.
+func (hm *haikuMon) readPort() {
+	buf := make([]byte, 4096)
+	for {
+		if _, err := readPort(hm.port, buf); err != nil {
+			return // the port was deleted by Close
+		}
+		select {
+		case hm.events <- struct{}{}:
+		default:
+		}
+	}
+}
+
+func (hm *haikuMon) Close() error {
+	hm.closeOnce.Do(func() {
+		close(hm.stop)
+		if hm.port >= 0 {
+			// Ends the subscription as well: the stack drops listeners
+			// whose port is gone.
+			deletePort(hm.port)
+		}
+	})
+	return nil
+}
+
+func (hm *haikuMon) Receive() (message, error) {
+	t := time.NewTimer(haikuPollInterval)
+	defer t.Stop()
+	select {
+	case <-hm.events:
+	case <-t.C:
+	case <-hm.stop:
+		return nil, errors.New("stopped")
+	}
+	return unspecifiedMessage{}, nil
+}
+
+// unspecifiedMessage is a wakeup that makes the monitor re-read the state.
+type unspecifiedMessage struct{}
+
+func (unspecifiedMessage) ignore() bool { return false }
