+		return
+	}
+	go func() {
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		ts := syscall.Timespec{Sec: int32(secs)}
+		syscall.Nanosleep(&ts, nil)
+		buf := make([]byte, 4<<20)
+		n := runtime.Stack(buf, true)
+		logf("Haiku stall dump after %ds:\n%s", secs, buf[:n])
+	}()
