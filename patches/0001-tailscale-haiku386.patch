index 0000000..87f552f
--- /dev/null
+++ b/client/local/dial_haiku.go
@@ -0,0 +1,74 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package local
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"strconv"
+
+	"tailscale.com/net/netutil"
+)
+
+// haikuUserDial performs the LocalAPI upgrade without net/http.Transport.
+// Haiku/386's non-blocking socket compatibility wrapper is reliable for raw
+// HTTP I/O, but the standard Transport's 101 body wrapper can turn an
+// EAGAIN while waiting for the upgraded peer into EOF and close ProxyCommand.
+func (lc *Client) haikuUserDial(ctx context.Context, network, host string, port uint16) (net.Conn, bool, error) {
+	c, err := lc.defaultDialer(ctx, network, "local-tailscaled.sock:80")
+	if err != nil {
+		return nil, true, err
+	}
+	closeConn := func() { _ = c.Close() }
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, "http://local-tailscaled.sock/localapi/v0/dial", nil)
+	if err != nil {
+		closeConn()
+		return nil, true, err
+	}
+	req.Header.Set("Upgrade", "ts-dial")
+	req.Header.Set("Connection", "upgrade")
+	req.Header.Set("Dial-Host", host)
+	req.Header.Set("Dial-Port", strconv.Itoa(int(port)))
+	req.Header.Set("Dial-Network", network)
+	if err := req.Write(c); err != nil {
+		closeConn()
+		return nil, true, err
+	}
+	br := bufio.NewReader(c)
+	res, err := http.ReadResponse(br, req)
+	if err != nil {
+		closeConn()
+		return nil, true, err
+	}
+	if res.StatusCode == http.StatusOK && res.Header.Get("Dial-Self") == "true" {
+		addr := res.Header.Get("Dial-Addr")
+		res.Body.Close()
+		closeConn()
+		if addr == "" {
+			return nil, true, fmt.Errorf("server returned Dial-Self without Dial-Addr")
+		}
+		if _, err := netip.ParseAddrPort(addr); err != nil {
+			return nil, true, fmt.Errorf("invalid Dial-Addr %q: %v", addr, err)
+		}
+		var d net.Dialer
+		out, err := d.DialContext(ctx, network, addr)
+		return out, true, err
+	}
+	if res.StatusCode != http.StatusSwitchingProtocols {
+		body, _ := io.ReadAll(io.LimitReader(res.Body, 1<<20))
+		res.Body.Close()
+		closeConn()
+		return nil, true, fmt.Errorf("unexpected LocalAPI dial response: %s, %s", res.Status, body)
+	}
+	// br may already contain bytes sent immediately after the 101 response.
+	// Keep those bytes in front of the raw upgraded connection.
+	return netutil.NewDrainBufConn(c, br), true, nil
+}
