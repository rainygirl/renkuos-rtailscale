diff --git a/net/netmon/interfaces_haiku.go b/net/netmon/interfaces_haiku.go
new file mode 100644
index 0000000..98422d8
--- /dev/null
+++ b/net/netmon/interfaces_haiku.go
@@ -0,0 +1,334 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build haiku
+
+package netmon
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"net"
+	"net/netip"
+	"runtime"
+	"syscall"
+	"unsafe"
+)
+
+// Go on Haiku has no interface enumeration: net.Interfaces returns an empty
+// list and a nil error. With no interfaces the monitor reports the network as
+// down, and netcheck then skips every STUN probe, which leaves the node
+// relay-only. So the interfaces are read here with the ioctls Haiku's own
+// ifconfig uses.
+func init() {
+	RegisterInterfaceGetter(haikuInterfaces)
+}
+
+// From <sys/sockio.h>, <net/if.h>, <net/route.h>.
+const (
+	siocGIFFLAGS     = 8907
+	siocGIFCONF      = 8911
+	siocGIFINDEX     = 8912
+	siocGIFMTU       = 8922
+	siocGRTSIZE      = 8926
+	siocGRTTABLE     = 8927
+	sockGetAlias     = 8948 // B_SOCKET_GET_ALIAS
+	sockCountAliases = 8949 // B_SOCKET_COUNT_ALIASES
+
+	iffUp        = 0x0001
+	iffBroadcast = 0x0002
+	iffLoopback  = 0x0008
+	iffPtP       = 0x0010
+	iffLink      = 0x1000 // the device has link
+	iffMulticast = 0x8000
+
+	ifNameSize = 32
+	// sizeof(struct ifreq): the name and a union whose largest member is
+	// struct ifreq_stats (56 bytes).
+	ifreqSize = ifNameSize + 56
+	// sizeof(struct route_entry): four pointers, flags and mtu.
+	routeEntrySize = 4*8 + 4 + 4
+)
+
+type ifreq [ifreqSize]byte
+
+func newIfreq(name string) *ifreq {
+	var r ifreq
+	copy(r[:ifNameSize-1], name)
+	return &r
+}
+
+func (r *ifreq) int32() int32 {
+	return int32(binary.LittleEndian.Uint32(r[ifNameSize:]))
+}
+
+// struct ifaliasreq: name, int index, then three sockaddr_storage (128 bytes,
+// 8-aligned) and the flags.
+type ifaliasreq [ifNameSize + 8 + 3*128 + 8]byte
+
+const (
+	aliasIndexOff = ifNameSize
+	aliasAddrOff  = ifNameSize + 8
+	aliasMaskOff  = aliasAddrOff + 2*128
+)
+
+func haikuSocket() (int, error) {
+	return syscall.Socket(syscall.AF_INET, syscall.SOCK_DGRAM, 0)
+}
+
+// haikuInterfaceNames lists the interfaces with SIOCGIFCONF. Each record is
+// the name, the interface's first address (with its own length), padded to
+// at least sizeof(struct ifreq).
+func haikuInterfaceNames(fd int) ([]string, error) {
+	buf := make([]byte, 64*ifreqSize)
+	var conf struct {
+		len int32
+		_   int32
+		buf unsafe.Pointer
+	}
+	conf.len = int32(len(buf))
+	conf.buf = unsafe.Pointer(&buf[0])
+	err := ioctl(fd, siocGIFCONF, unsafe.Pointer(&conf), unsafe.Sizeof(conf))
+	runtime.KeepAlive(buf)
+	if err != nil {
+		return nil, err
+	}
+	b := buf[:conf.len]
+	var names []string
+	for len(b) >= ifNameSize+2 {
+		name := string(b[:bytes.IndexByte(append(b[:ifNameSize:ifNameSize], 0), 0)])
+		n := ifNameSize + int(b[ifNameSize])
+		if n < ifreqSize {
+			n = ifreqSize
+		}
+		if n > len(b) {
+			n = len(b)
+		}
+		b = b[n:]
+		if name != "" {
+			names = append(names, name)
+		}
+	}
+	return names, nil
+}
+
+// sockaddrIP decodes a sockaddr_in or sockaddr_in6.
+func sockaddrIP(sa []byte) (netip.Addr, bool) {
+	if len(sa) < 2 {
+		return netip.Addr{}, false
+	}
+	switch sa[1] {
+	case syscall.AF_INET:
+		if len(sa) >= 8 {
+			return netip.AddrFrom4([4]byte(sa[4:8])), true
+		}
+	case syscall.AF_INET6:
+		if len(sa) >= 24 {
+			return netip.AddrFrom16([16]byte(sa[8:24])), true
+		}
+	}
+	return netip.Addr{}, false
+}
+
+// maskBits converts a netmask sockaddr into a prefix length.
+func maskBits(sa []byte, family byte, bits int) int {
+	m, ok := sockaddrIP(sa)
+	if !ok || sa[1] != family {
+		return bits
+	}
+	ones, total := net.IPMask(m.AsSlice()).Size()
+	if total == 0 {
+		return bits // not a contiguous mask
+	}
+	return ones
+}
+
+func haikuInterface(fd int, name string) (Interface, error) {
+	ni := &net.Interface{Name: name}
+
+	r := newIfreq(name)
+	if err := ioctl(fd, siocGIFINDEX, unsafe.Pointer(r), ifreqSize); err != nil {
+		return Interface{}, err
+	}
+	ni.Index = int(r.int32())
+
+	r = newIfreq(name)
+	if err := ioctl(fd, siocGIFFLAGS, unsafe.Pointer(r), ifreqSize); err != nil {
+		return Interface{}, err
+	}
+	flags := r.int32()
+	// An interface is only usable while its device has link: report it
+	// down otherwise, so that losing the link is seen as a change.
+	if flags&iffUp != 0 && (flags&iffLink != 0 || flags&iffLoopback != 0) {
+		ni.Flags |= net.FlagUp | net.FlagRunning
+	}
+	if flags&iffBroadcast != 0 {
+		ni.Flags |= net.FlagBroadcast
+	}
+	if flags&iffLoopback != 0 {
+		ni.Flags |= net.FlagLoopback
+	}
+	if flags&iffPtP != 0 {
+		ni.Flags |= net.FlagPointToPoint
+	}
+	if flags&iffMulticast != 0 {
+		ni.Flags |= net.FlagMulticast
+	}
+
+	r = newIfreq(name)
+	if ioctl(fd, siocGIFMTU, unsafe.Pointer(r), ifreqSize) == nil {
+		ni.MTU = int(r.int32())
+	}
+
+	r = newIfreq(name)
+	if err := ioctl(fd, sockCountAliases, unsafe.Pointer(r), ifreqSize); err != nil {
+		return Interface{}, err
+	}
+	count := int(r.int32())
+	addrs := []net.Addr{} // non-nil: Interface.Addrs must not ask net
+	for i := range count {
+		var a ifaliasreq
+		copy(a[:ifNameSize-1], name)
+		binary.LittleEndian.PutUint32(a[aliasIndexOff:], uint32(i))
+		if ioctl(fd, sockGetAlias, unsafe.Pointer(&a), unsafe.Sizeof(a)) != nil {
+			continue // removed meanwhile
+		}
+		ip, ok := sockaddrIP(a[aliasAddrOff : aliasAddrOff+128])
+		if !ok || ip.IsUnspecified() {
+			continue
+		}
+		bits := maskBits(a[aliasMaskOff:aliasMaskOff+128], a[aliasAddrOff+1], ip.BitLen())
+		addrs = append(addrs, &net.IPNet{IP: ip.AsSlice(), Mask: net.CIDRMask(bits, ip.BitLen())})
+	}
+	return Interface{Interface: ni, AltAddrs: addrs}, nil
+}
+
+func haikuInterfaces() ([]Interface, error) {
+	fd, err := haikuSocket()
+	if err != nil {
+		return nil, err
+	}
+	defer syscall.Close(fd)
+	names, err := haikuInterfaceNames(fd)
+	if err != nil {
+		return nil, err
+	}
+	var ret []Interface
+	for _, name := range names {
+		ifc, err := haikuInterface(fd, name)
+		if err != nil {
+			continue // removed while we were looking
+		}
+		ret = append(ret, ifc)
+	}
+	return ret, nil
+}
+
+// defaultRoute returns the interface of the IPv4 default route, or failing
+// that the IPv6 one, ignoring the Tailscale interface.
+func defaultRoute() (DefaultRouteDetails, error) {
+	tsIf, _ := TailscaleInterfaceName()
+	for _, family := range []int{syscall.AF_INET, syscall.AF_INET6} {
+		name, err := haikuDefaultRouteIf(family, tsIf)
+		if err != nil || name == "" {
+			continue
+		}
+		d := DefaultRouteDetails{InterfaceName: name}
+		if fd, err := haikuSocket(); err == nil {
+			r := newIfreq(name)
+			if ioctl(fd, siocGIFINDEX, unsafe.Pointer(r), ifreqSize) == nil {
+				d.InterfaceIndex = int(r.int32())
+			}
+			syscall.Close(fd)
+		}
+		return d, nil
+	}
+	return DefaultRouteDetails{}, errNoDefaultRoute
+}
+
+var errNoDefaultRoute = errors.New("no default route")
+
+// haikuDefaultRouteIf reads the routing table of one address family with
+// SIOCGRTTABLE. Each record is the interface name and a struct route_entry,
+// followed by the destination, mask and gateway sockaddrs its pointers point
+// to, in that order, each present only if its pointer is set.
+func haikuDefaultRouteIf(family int, tsIf string) (string, error) {
+	fd, err := syscall.Socket(family, syscall.SOCK_DGRAM, 0)
+	if err != nil {
+		return "", err
+	}
+	defer syscall.Close(fd)
+
+	var conf struct {
+		len int32
+		_   int32
+		buf unsafe.Pointer
+	}
+	if err := ioctl(fd, siocGRTSIZE, unsafe.Pointer(&conf), unsafe.Sizeof(conf)); err != nil {
+		return "", err
+	}
+	size := int(*(*int32)(unsafe.Pointer(&conf.buf)))
+	if size <= 0 {
+		return "", nil
+	}
+	buf := make([]byte, size+16*(ifNameSize+routeEntrySize+3*32)) // room for a route added meanwhile
+	conf.len = int32(len(buf))
+	conf.buf = unsafe.Pointer(&buf[0])
+	err = ioctl(fd, siocGRTTABLE, unsafe.Pointer(&conf), unsafe.Sizeof(conf))
+	runtime.KeepAlive(buf)
+	if err != nil {
+		return "", err
+	}
+
+	b := buf
+	for len(b) >= ifNameSize+routeEntrySize {
+		name := string(b[:bytes.IndexByte(append(b[:ifNameSize:ifNameSize], 0), 0)])
+		if name == "" {
+			break // end of the table: the rest of the buffer is zero
+		}
+		e := b[ifNameSize:]
+		le := binary.LittleEndian
+		hasDst, hasMask, hasGw := le.Uint64(e[0:]) != 0, le.Uint64(e[8:]) != 0, le.Uint64(e[16:]) != 0
+		rest := b[ifNameSize+routeEntrySize:]
+		next := func() []byte {
+			if len(rest) < 1 || int(rest[0]) > len(rest) || rest[0] == 0 {
+				rest = nil
+				return nil
+			}
+			sa := rest[:rest[0]]
+			rest = rest[rest[0]:]
+			return sa
+		}
+		var dst, mask []byte
+		if hasDst {
+			dst = next()
+		}
+		if hasMask {
+			mask = next()
+		}
+		if hasGw {
+			next()
+		}
+		if rest == nil {
+			break
+		}
+		b = rest
+
+		if name == tsIf {
+			continue
+		}
+		// A default route has an unspecified (or no) destination and a
+		// zero-length (or no) mask.
+		if ip, ok := sockaddrIP(dst); dst != nil && (!ok || !ip.IsUnspecified()) {
+			continue
+		}
+		if mask != nil {
+			if m, ok := sockaddrIP(mask); ok && !m.IsUnspecified() {
+				continue
+			}
+		}
+		return name, nil
+	}
+	return "", nil
+}
