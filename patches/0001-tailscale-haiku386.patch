+// startHaikuStallDumper dumps every goroutine's stack after
+// TS_HAIKU_STALL_DUMP seconds, so a startup that freezes leaves evidence.
+//
+// SIGQUIT is not usable here: sending it to a wedged tailscaled on Haiku
+// produces no dump at all. Like haikuListenerPoker this pins an OS thread and
+// paces with a raw nanosleep, because a wedge takes the Go timers down with it.
+func startHaikuStallDumper(logf logger.Logf) {
+	secs, err := strconv.Atoi(os.Getenv("TS_HAIKU_STALL_DUMP"))
