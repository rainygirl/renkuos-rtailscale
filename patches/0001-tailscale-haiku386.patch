+// doHaikuWithRetry retries a LocalAPI request whose response headers timed out.
+//
+// On Haiku/386 the netpoller occasionally loses a socket's read wakeup, so an
+// individual request can stall even though the daemon is healthy - the very next
+// request on a fresh connection succeeds. ResponseHeaderTimeout turns the stall
+// into an error; retrying here means a single unlucky request no longer fails a
+// whole command (`tailscale up` was giving up at whichever call happened to be
+// hit: status, then check-prefs). Only retried when the request is safely
+// replayable: no body, or a body with GetBody (which net/http provides for the
+// byte-buffer bodies the LocalAPI client uses; anything else is buffered here
+// so it becomes replayable too).
+func (lc *Client) doHaikuWithRetry(req *http.Request) (*http.Response, error) {
+	if req.Body != nil && req.GetBody == nil {
+		// Make the request replayable. LocalAPI bodies are small (prefs, JSON
+		// commands), so buffering costs nothing. Without this the retry could
+		// not clone the request and the whole call failed with "cannot retry
+		// request without GetBody" - which is exactly what `tailscale up` hit
+		// on /localapi/v0/start, i.e. the retry turned a recoverable stall into
+		// a hard failure on the one request that matters most.
+		body, err := io.ReadAll(req.Body)
+		req.Body.Close()
+		if err != nil {
+			return nil, err
+		}
+		req.Body = io.NopCloser(bytes.NewReader(body))
+		req.ContentLength = int64(len(body))
+		req.GetBody = func() (io.ReadCloser, error) {
+			return io.NopCloser(bytes.NewReader(body)), nil
+		}
+	}
+	const attempts = 4
+	for i := 0; ; i++ {
+		r := req
+		if i > 0 {
+			var err error
+			r, err = haikuCloneRequest(req)
+			if err != nil {
+				// Not replayable after all: return the stall as-is rather than
+				// masking it with a clone error.
+				return nil, err
+			}
+		}
+		res, err := lc.tsClient.Do(r)
+		if err == nil || i == attempts-1 || !haikuRetryableErr(err) {
+			return res, err
+		}
+	}
+}
+
+func haikuRetryableErr(err error) bool {
+	if err == nil {
+		return false
+	}
+	// net/http reports the header deadline as this exact string; it is not an
+	// exported error value.
+	return strings.Contains(err.Error(), "timeout awaiting response headers")
+}
+
+func haikuCloneRequest(req *http.Request) (*http.Request, error) {
+	r2 := req.Clone(req.Context())
+	if req.Body == nil {
+		return r2, nil
+	}
+	if req.GetBody == nil {
+		return nil, fmt.Errorf("cannot retry request without GetBody")
+	}
+	body, err := req.GetBody()
+	if err != nil {
+		return nil, err
+	}
+	r2.Body = body
+	return r2, nil
+}
+
